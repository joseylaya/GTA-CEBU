APP_ENV=local
DATABASE_URL=postgresql+asyncpg://splitshare:splitshare@localhost:5432/splitshare
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# Supabase: use its Postgres connection string above and the JWT secret from
# Project Settings > API. Never expose this secret to the Flutter client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWT_SECRET=replace-with-the-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# Absolute path in the deployed API container; do not commit the JSON key.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
