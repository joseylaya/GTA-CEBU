{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/ws.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/models/(.*).obj",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://dz.jmgaming.site/",
      "permanent": false
    },
    {
      "source": "/:path+",
      "destination": "https://dz.jmgaming.site/:path+",
      "permanent": false
    }
  ]
}
